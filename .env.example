# PUBLIC_ORIGIN и VITE_SITE_URL должны совпадать с адресом сайта без завершающего /.
# Для production: DOMAIN=gifts.example.com, остальные два = https://gifts.example.com.
# Для pnpm dev: PUBLIC_ORIGIN и VITE_SITE_URL = http://localhost:5173.
DOMAIN=http://localhost
PUBLIC_ORIGIN=http://localhost
VITE_SITE_URL=http://localhost

# Только compose.dev.yml; если 5432 занят, задайте 15432 и измените DATABASE_URL.
POSTGRES_PORT=5432
POSTGRES_DB=povod
POSTGRES_USER=povod
# Перед размещением на сервере замените на длинный случайный URL-safe пароль.
POSTGRES_PASSWORD=replace-with-strong-password
# Separate runtime accounts; use distinct random URL-safe passwords (for example 32-byte hex).
# migrate creates/updates these accounts after schema migrations; see docs/database-access.md.
DB_API_USER=povod_api
DB_API_PASSWORD=replace-with-distinct-api-password
DB_WORKER_USER=povod_worker
DB_WORKER_PASSWORD=replace-with-distinct-worker-password
# Native development uses localhost. Keep each URL in sync with the credentials above.
# Run db:migrate before starting the API/worker for the first time.
DATABASE_URL=postgresql://povod_api:replace-with-distinct-api-password@localhost:5432/povod
WORKER_DATABASE_URL=postgresql://povod_worker:replace-with-distinct-worker-password@localhost:5432/povod
MIGRATION_DATABASE_URL=postgresql://povod:replace-with-strong-password@localhost:5432/povod
# Compose supplies only the relevant DATABASE_URL to each service. Admin credentials go to migrate.

# Без VK-настроек заявка сохраняется; worker оставляет уведомление в очереди. См. docs/vk-setup.md.
VK_GROUP_TOKEN=
VK_GROUP_ID=
VK_PEER_ID=
VK_API_VERSION=5.199

NODE_ENV=development
HOST=0.0.0.0
PORT=3001
LOG_LEVEL=info
# 0 для native development; production compose устанавливает 1 (единственный proxy Caddy).
TRUST_PROXY_HOPS=0
RATE_LIMIT_MAX=8
WORKER_POLL_MS=3000
WORKER_LOCK_MS=120000
VK_TIMEOUT_MS=15000
# Only a disposable test database: integration tests clear its lead/outbox tables.
# TEST_DATABASE_URL=postgresql://povod:replace-with-strong-password@localhost:5432/povod_test
